# ============================================================
# 智能教育系统 后端 敏感配置（严禁提交至版本控制！）
# ============================================================

# JWT 签名密钥（必填！可用 openssl rand -hex 32 生成）
SECRET_KEY=you-key

# 数据库密码（必填！若密码含特殊字符如 @，原样填入即可，程序内部会自动 URL 编码）
MYSQL_PASSWORD=you-password

# 大语言模型 API 密钥
LLM_API_KEY=you-apikey

# Embedding 向量化模型 API 密钥
EMBEDDING_API_KEY=you-apikey

# CORS 允许的前端来源（多个用英文逗号分隔，生产环境改为真实域名）
ALLOWED_ORIGINS=on-you-own
